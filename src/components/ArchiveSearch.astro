---
// Reusable searchable archive shell (used by Workshops & Reading Group; can be
// adopted by Projects/Events later). Renders a search box + tag chips and
// filters the slotted items client-side.
//
// Each slotted item MUST carry:
//   data-archive-item
//   data-title  = item title, lowercased
//   data-tags   = item tags, lowercased, joined with "|"
//
// Styled for a LIGHT (white) panel.
//
// Pass `tags` for a single unlabelled row of chips, or `groups` to split the
// chips into labelled rows — filtering treats them identically, but a reader
// shouldn't have to guess that "Team Full" and "Robotics" mean different kinds
// of thing. `variant: "status"` renders the filled style.
export interface ChipGroup {
  label: string;
  tags: Array<string>;
  variant?: "status" | "topic";
}
export interface Props {
  tags?: Array<string>;
  groups?: Array<ChipGroup>;
  placeholder?: string;
}
const {
  tags = [],
  groups = [],
  placeholder = "Search by title or tag…",
} = Astro.props;

const chipGroups: Array<ChipGroup> =
  groups.length > 0
    ? groups.filter((g) => g.tags.length > 0)
    : tags.length > 0
    ? [{ label: "", tags }]
    : [];
---

<div data-archive>
  <div class="flex flex-col gap-4">
    <input
      type="text"
      data-archive-input
      placeholder={placeholder}
      aria-label="Search"
      class="border-black/15 w-full border-2 bg-transparent px-4 py-3 text-black outline-none transition placeholder:text-black/40 focus:border-[#A45DF5]"
    />

    {
      chipGroups.map(({ label, tags: groupTags, variant = "topic" }) => (
        <div>
          {label && (
            <p class="mb-2 font-semibold uppercase tracking-wide opacity-50 text-xs">
              {label}
            </p>
          )}
          <div class="flex flex-wrap gap-2">
            {groupTags.map((t) => (
              <button
                type="button"
                data-tag-chip={t}
                class={`chip px-3 py-1 font-semibold transition text-sm ${
                  variant === "status"
                    ? "rounded-full border-2 border-[#A45DF5]/40 hover:border-[#A45DF5]"
                    : "border border-black/20 hover:border-[#A45DF5]"
                }`}
              >
                {t}
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-8">
    <slot />
    <p data-archive-empty class="hidden py-10 text-center opacity-60 text-lg">
      No results. Try a different search or tag.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-archive]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("[data-archive-input]");
    const chips = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-tag-chip]")
    );
    const items = Array.from(
      root.querySelectorAll<HTMLElement>("[data-archive-item]")
    );
    const empty = root.querySelector<HTMLElement>("[data-archive-empty]");
    const active = new Set<string>();

    const apply = () => {
      const q = (input?.value || "").trim().toLowerCase();
      let visible = 0;
      items.forEach((el) => {
        const title = el.getAttribute("data-title") || "";
        const tags = (el.getAttribute("data-tags") || "")
          .split("|")
          .filter(Boolean);
        const textMatch =
          !q || title.includes(q) || tags.some((t) => t.includes(q));
        const chipMatch = active.size === 0 || tags.some((t) => active.has(t));
        const show = textMatch && chipMatch;
        el.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      empty?.classList.toggle("hidden", visible !== 0);
    };

    input?.addEventListener("input", apply);
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const tag = (chip.dataset.tagChip || "").toLowerCase();
        if (active.has(tag)) active.delete(tag);
        else active.add(tag);
        chip.classList.toggle("chip-active", active.has(tag));
        apply();
      });
    });

    apply();
  });
</script>

<style>
  .chip-active {
    background: #a45df5;
    border-color: #a45df5;
    color: #fff;
  }
</style>
