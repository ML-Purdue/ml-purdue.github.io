---
// Project card for the light (white) panels on /projects and /projects/archive.
// Carries the data-* attributes ArchiveSearch filters on.
import {
  INTAKE_LABELS,
  PM_APPLICATION_URL,
  formatRunLine,
} from "~/lib/projects";
import type { Project } from "~/lib/projects";

export interface Props {
  project: Project;
}
const { project } = Astro.props;
const { data } = project;

const badge =
  data.status === "archived"
    ? { label: "Archived", class: "bg-gray-600" }
    : {
        open: { label: INTAKE_LABELS.open, class: "bg-emerald-600" },
        full: { label: INTAKE_LABELS.full, class: "bg-[#A45DF5]" },
        tbd: { label: INTAKE_LABELS.tbd, class: "bg-gray-500" },
      }[data.intake!];

// Search matches on title, tags, PM and advisor so people can find a project by
// who ran it.
const searchTags = [
  ...data.domain,
  ...(data.status === "active" ? [INTAKE_LABELS[data.intake!]] : ["Archived"]),
];
---

<article
  data-archive-item
  data-title={[data.name, data.pm ?? "", data.advisor ?? ""]
    .join(" ")
    .toLowerCase()}
  data-tags={searchTags.map((t) => t.toLowerCase()).join("|")}
  class="border-black/15 flex flex-col border p-6 transition hover:border-[#A45DF5]"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-bold leading-tight text-2xl">
      <a href={`/projects/${project.slug}`} class="hover:!text-[#A45DF5]">
        {data.name}
      </a>
    </h3>
    <span
      class={`whitespace-nowrap rounded-md px-3 py-1 text-xs font-semibold text-white ${badge.class}`}
    >
      {badge.label}
    </span>
  </div>

  <p class="mt-2 font-semibold opacity-60 text-sm">
    {formatRunLine(data)}
    {data.hoursPerWeek && <span> · {data.hoursPerWeek} hrs/week</span>}
  </p>

  {
    data.domain.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {data.domain.map((d) => (
          <span class="bg-[#A45DF5] px-3 py-1 font-semibold text-white text-xs">
            {d}
          </span>
        ))}
      </div>
    )
  }

  <p class="mt-4 opacity-80 text-sm">{data.desc}</p>

  {
    data.results.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {data.results.map((r) => (
          <span class="font-semibold text-[#A45DF5] text-xs">★ {r}</span>
        ))}
      </div>
    )
  }

  <div class="mt-auto pt-4 text-sm">
    {
      /* An active project with no PM is a vacancy worth advertising; a past one
         with no PM is just a gap in the record, so stay quiet about it. */
      (data.pm || data.status === "active") && (
        <p class="font-semibold">
          <span class="uppercase tracking-wide opacity-50 text-xs">
            Project Manager
          </span>
          <br />
          {data.pm ?? (
            <a href={PM_APPLICATION_URL} class="text-[#A45DF5] hover:underline">
              Recruiting; apply to lead →
            </a>
          )}
        </p>
      )
    }
    {
      data.advisor && (
        <p class="mt-2 opacity-60 text-xs">Advisor · {data.advisor}</p>
      )
    }
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4 font-semibold text-sm">
    <a
      href={`/projects/${project.slug}`}
      class="group inline-flex items-center gap-1.5 hover:!text-[#A45DF5]"
    >
      Details
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-200 group-hover:translate-x-1"
      >
        <path
          d="M5 12h14M13 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
    {
      data.github && (
        <a href={data.github} class="hover:!text-[#A45DF5]">
          GitHub
        </a>
      )
    }
  </div>
</article>
