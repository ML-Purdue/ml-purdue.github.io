---
import "@fontsource/inter/variable.css";
import { getCollection } from "astro:content";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import "~/styles/index.css";
import {
  INTAKE_LABELS,
  PM_APPLICATION_URL,
  formatRunLine,
} from "~/lib/projects";
import type { Project } from "~/lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((p) => !p.data.draft)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props as Props;
const { data } = project;
const { Content } = await project.render();

const { site } = Astro;

const badge =
  data.status === "archived"
    ? { label: "Archived", class: "bg-gray-600" }
    : {
        open: { label: INTAKE_LABELS.open, class: "bg-emerald-600" },
        full: { label: INTAKE_LABELS.full, class: "bg-[#A45DF5]" },
        tbd: { label: INTAKE_LABELS.tbd, class: "bg-gray-500" },
      }[data.intake!];

const facts = [
  { label: "Ran", value: formatRunLine(data) },
  {
    label: "Commitment",
    value: data.hoursPerWeek && `${data.hoursPerWeek} hrs/week`,
  },
  { label: "Openings", value: data.openings },
].filter((f) => f.value);
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{`ML@Purdue - ${data.name}`}</title>
    <meta name="description" content={data.desc} />
    <meta property="og:title" content={`ML@Purdue - ${data.name}`} />
    <meta property="og:type" content="article" />
    <meta property="og:description" content={data.desc} />
    <meta property="og:image" content="/social.png" />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header fixed />

    <!-- Hero -->
    <section class="w-full bg-black pt-28 pb-16 text-white">
      <div class="mx-auto w-[90vw] max-w-4xl">
        <a
          href={data.status === "archived" ? "/projects/archive" : "/projects"}
          class="font-semibold opacity-70 transition text-sm hover:!text-[#A45DF5] hover:opacity-100"
        >
          ← {
            data.status === "archived" ? "Back to archive" : "Back to projects"
          }
        </a>

        <div class="mt-4 flex flex-wrap items-center gap-4">
          <h2 class="orbitron font-bold text-4xl sm:text-6xl">{data.name}</h2>
          <span
            class={`whitespace-nowrap rounded-md px-3 py-1 text-xs font-semibold text-white ${badge.class}`}
          >
            {badge.label}
          </span>
        </div>

        <p class="mt-5 max-w-3xl opacity-90 text-lg">{data.desc}</p>

        {
          (data.pm || data.status === "active") && (
            <p class="mt-6 text-lg">
              <span class="uppercase tracking-wide opacity-50 text-sm">
                Project Manager
              </span>
              <br />
              {data.pm ? (
                <span class="font-bold text-[#A45DF5]">{data.pm}</span>
              ) : (
                <a
                  href={PM_APPLICATION_URL}
                  class="font-bold text-[#A45DF5] hover:underline"
                >
                  Recruiting; apply to lead this project →
                </a>
              )}
            </p>
          )
        }
        {
          data.advisor && (
            <p class="mt-3 opacity-60 text-sm">Advisor · {data.advisor}</p>
          )
        }

        {
          data.domain.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {data.domain.map((d) => (
                <span class="bg-[#A45DF5] px-3 py-1 font-semibold text-white text-xs">
                  {d}
                </span>
              ))}
            </div>
          )
        }

        {
          (data.github || data.links.length > 0) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {data.github && (
                <a
                  href={data.github}
                  class="border-2 border-white px-5 py-2 font-semibold transition text-sm hover:border-[#A45DF5] hover:!text-[#A45DF5]"
                >
                  GitHub
                </a>
              )}
              {data.links.map((l) => (
                <a
                  href={l.url}
                  class="border-2 border-white/40 px-5 py-2 font-semibold transition text-sm hover:border-[#A45DF5] hover:!text-[#A45DF5]"
                >
                  {l.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- Body -->
    <section class="w-full bg-white py-16 text-black">
      <div class="mx-auto w-[90vw] max-w-4xl">
        <!-- Facts -->
        <dl
          class="grid grid-cols-1 gap-x-8 gap-y-5 border-b border-black/10 pb-10 sm:grid-cols-3"
        >
          {
            facts.map(({ label, value }) => (
              <div>
                <dt class="font-semibold uppercase tracking-wide opacity-50 text-xs">
                  {label}
                </dt>
                <dd class="mt-1 font-semibold">{value}</dd>
              </div>
            ))
          }
        </dl>

        {
          data.results.length > 0 && (
            <div class="mt-10">
              <h3 class="font-bold text-2xl">Results</h3>
              <ul class="mt-4 flex flex-col gap-2">
                {data.results.map((r) => (
                  <li class="font-semibold text-[#A45DF5]">★ {r}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          data.editions.length > 0 && (
            <div class="mt-10">
              <h3 class="font-bold text-2xl">Every year we've competed</h3>
              <ul class="mt-4 divide-y divide-black/10 border-y border-black/10">
                {data.editions.map((e) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-2 py-3">
                    <span class="font-bold">{e.years}</span>
                    {e.result && (
                      <span class="opacity-70 text-sm">{e.result}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          data.skills && (
            <div class="mt-10 border-l-4 border-[#A45DF5] bg-black/[0.03] p-6">
              <h3 class="font-bold text-xl">What you need coming in</h3>
              <p class="mt-3 opacity-80">{data.skills}</p>
            </div>
          )
        }

        <article class="project-body mt-12">
          <Content />
        </article>
      </div>
    </section>

    <Footer />
  </body>
</html>

<style is:global>
  /* Markdown body for project write-ups migrated from Notion. */
  .project-body h1,
  .project-body h2 {
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.2;
    margin: 2.5rem 0 1rem;
  }
  .project-body h3 {
    font-weight: 700;
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }
  .project-body p {
    margin: 1rem 0;
    opacity: 0.85;
    line-height: 1.7;
  }
  .project-body ul,
  .project-body ol {
    margin: 1rem 0 1rem 1.5rem;
    opacity: 0.85;
    line-height: 1.7;
  }
  .project-body ul {
    list-style: disc;
  }
  .project-body ol {
    list-style: decimal;
  }
  .project-body li {
    margin: 0.4rem 0;
  }
  .project-body a {
    color: #a45df5;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .project-body strong {
    font-weight: 700;
    opacity: 1;
  }
  .project-body blockquote {
    border-left: 4px solid rgba(0, 0, 0, 0.15);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    opacity: 0.75;
  }
  .project-body code {
    background: rgba(0, 0, 0, 0.06);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }
</style>
