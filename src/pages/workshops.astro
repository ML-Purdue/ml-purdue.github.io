---
import "@fontsource/inter/variable.css";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import ArchiveSearch from "~/components/ArchiveSearch.astro";
import "~/styles/index.css";
import { workshopItems } from "~/data-entries";

const { site } = Astro;
const description = "ML@Purdue Website";

// CTA target — join the community to hear about upcoming workshops.
const DISCORD_URL = "https://discord.gg/KphYQFSVsu";

// Chip list = sorted unique tags across all workshops.
const workshopTags = [
  ...new Set(workshopItems.flatMap((w) => w.tags ?? [])),
].sort();
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ML@Purdue - Workshops</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="ML@Purdue" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/social.png" />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header fixed />

    <!-- Hero -->
    <section class="w-full bg-black pt-28 pb-20 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="orbitron font-bold text-6xl sm:text-8xl">Workshops</h2>
        <p class="mt-6 max-w-2xl text-base opacity-90 sm:text-lg">
          Our workshops are open to everyone. Each runs about 60–90 minutes and is a
          hands-on, interactive session. Timing is posted on our Discord and Instagram.
          Join our Discord to hear about what's coming up.
        </p>

        <a
          href={DISCORD_URL}
          class="group mt-10 inline-flex items-center gap-3 bg-[#A45DF5] px-8 py-4 text-lg font-semibold text-white transition hover:opacity-90 hover:!text-white"
        >
          Join our Discord
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </section>

    <!-- Searchable archive -->
    <section class="w-full bg-white py-20 text-black">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Archive</h2>
        <p class="mt-6 mb-10 max-w-2xl text-lg opacity-70">
          Every past workshop. Search by title or filter by topic.
        </p>

        <ArchiveSearch tags={workshopTags}>
          <div class="grid gap-4 sm:grid-cols-2">
            {
              workshopItems.map((w) => {
                const tags = w.tags ?? [];
                return (
                  <article
                    data-archive-item
                    data-title={w.topic.toLowerCase()}
                    data-tags={tags.map((t) => t.toLowerCase()).join("|")}
                    class="flex flex-col border border-black/15 p-6"
                  >
                    <h3 class="font-bold text-2xl">{w.topic}</h3>
                    {tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {tags.map((t) => (
                          <span class="bg-[#A45DF5] px-3 py-1 text-xs font-semibold text-white">
                            {t}
                          </span>
                        ))}
                      </div>
                    )}
                    <p class="mt-4 text-sm opacity-70">
                      {w.date} · {w.leading}
                    </p>
                  </article>
                );
              })
            }
          </div>
        </ArchiveSearch>
      </div>
    </section>

    <Footer />
  </body>
</html>
