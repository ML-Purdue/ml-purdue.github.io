---
import "@fontsource/inter/variable.css";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import ArchiveSearch from "~/components/ArchiveSearch.astro";
import "~/styles/index.css";
import { projectItems } from "~/data-entries";

const { site } = Astro;
const description = "ML@Purdue Website";

const NOTION_URL =
  "https://www.notion.so/mlpurdue/8e83150770684e118ed6f423ba54fb81?v=b403456229e8436f8f80740ac735e90a";
const D2L_URL = "https://d2l.ai/";

const highlights = [
  {
    tag: "COMPETITION",
    title: "TE AI Cup",
    body: "1st National / 2nd Global (2024) · 2nd National / 3rd Global (2025) · 2 Patents Filed",
  },
  {
    tag: "ROBOTICS",
    title: "RoBoat",
    body: "2nd Overall Grand Champion · AIMM ICC Competition",
  },
  {
    tag: "PRODUCT",
    title: "InboxPilot",
    body: "4,000+ emails processed · 100+ auto-generated drafts",
  },
];

const projectTags = [...new Set(projectItems.flatMap((p) => p.domain))].sort();
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ML@Purdue - Projects</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="ML@Purdue" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/social.png" />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header fixed />

    <!-- Hero -->
    <section class="w-full bg-black pt-28 pb-20 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="orbitron font-bold text-6xl sm:text-8xl">Projects</h2>
        <p class="mt-6 max-w-3xl text-base opacity-90 sm:text-lg">
          Projects are where members go deep. Small teams, real stakes, weekly
          syncs, and deliverables that go on your resume. Past teams have filed
          patents, won national competitions, and deployed products with real
          users.
        </p>

        <a
          href={NOTION_URL}
          class="group mt-10 inline-flex items-center gap-3 bg-[#A45DF5] px-8 py-4 text-lg font-semibold text-white transition hover:opacity-90 hover:!text-white"
        >
          View project details
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </section>

    <!-- Highlights -->
    <section class="w-full bg-[#A45DF5] py-14 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Project Highlights</h2>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          {
            highlights.map(({ tag, title, body }) => (
              <div class="rounded-lg border border-white/30 bg-black/20 p-6">
                <span class="font-semibold text-xs uppercase tracking-wide opacity-80">
                  {tag}
                </span>
                <h3 class="mt-2 text-2xl font-bold">{title}</h3>
                <p class="mt-3 text-sm opacity-90">{body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Current projects -->
    <section class="w-full bg-white py-20 text-black">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Current Projects</h2>
        <p class="mt-6 mb-10 max-w-2xl text-lg opacity-70">
          Each project operates as a focused team with clear milestones,
          weekly syncs, and deliverable goals. Projects typically run for a
          few semesters with 3-4 major milestones and are time intensive,
          exposing members to a wide range of skills and technologies. More
          information can be found on our{" "}
          <a href={NOTION_URL} class="font-bold underline decoration-2 underline-offset-4 hover:opacity-70">
            notion page
          </a>.
        </p>

        <ArchiveSearch tags={projectTags}>
          <div class="grid gap-4 sm:grid-cols-2">
            {
              projectItems.map(
                ({
                  link,
                  name,
                  desc,
                  pm,
                  status,
                  commitment,
                  proficiency,
                  domain,
                  duration,
                  advisor,
                  memberInfo,
                  accomplishments,
                }) => (
                  <article
                    data-archive-item
                    data-title={name.toLowerCase()}
                    data-tags={domain.map((d) => d.toLowerCase()).join("|")}
                    class="flex flex-col border border-black/15 p-6"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <h3 class="text-2xl font-bold leading-tight">
                        {link ? <a href={link} class="hover:!text-[#A45DF5]">{name}</a> : <span>{name}</span>}
                      </h3>
                      <span
                        class={`whitespace-nowrap rounded-md px-3 py-1 text-xs font-semibold text-white ${
                          status == "closed" ? "bg-gray-700" : "bg-[#A45DF5]"
                        }`}
                      >
                        {status}
                      </span>
                    </div>

                    {domain.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {domain.map((d) => (
                          <span class="bg-[#A45DF5] px-3 py-1 text-xs font-semibold text-white">
                            {d}
                          </span>
                        ))}
                      </div>
                    )}

                    <p class="mt-4 text-sm opacity-80">{desc}</p>

                    {accomplishments && accomplishments.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
                        {accomplishments.map((a) => (
                          <span class="text-xs font-semibold text-[#A45DF5]">★ {a}</span>
                        ))}
                      </div>
                    )}

                    <p class="mt-4 text-sm opacity-70">
                      {duration}
                      {proficiency && <span> · {proficiency}</span>}
                      {commitment && <span> · {commitment} hrs/week</span>}
                    </p>
                    <p class="mt-1 text-sm opacity-70">
                      {pm}
                      {advisor && <span> · Advisor: {advisor}</span>}
                    </p>

                    {memberInfo && (
                      <div class="mt-4">
                        <a
                          href={memberInfo}
                          class="group inline-flex items-center gap-2 border-2 border-current px-3 py-1.5 text-sm font-semibold transition hover:border-[#A45DF5] hover:!text-[#A45DF5]"
                        >
                          Member info
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      </div>
                    )}
                  </article>
                )
              )
            }
          </div>
        </ArchiveSearch>
      </div>
    </section>

    <!-- Get involved -->
    <section class="w-full bg-black py-20 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Get Involved</h2>

        <!-- Join a project: full width -->
        <div class="mt-10 border border-white/15 p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="font-bold text-[#A45DF5] text-2xl">Join a Project</h3>
            <span class="text-xs font-semibold uppercase tracking-wide opacity-60">
              ~20-30% acceptance rate
            </span>
          </div>
          <p class="mt-3 max-w-3xl text-sm opacity-80">
            Applications open at the start of each semester. Projects are
            competitive and require demonstrated ML experience or a strong
            technical background. A project manager reviews your application
            and selects you if they believe you're a good fit, and may follow
            up with additional questions before confirming.
          </p>

          <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
            <div class="bg-white/5 p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-[#A45DF5]">
                Phase 1
              </span>
              <h4 class="mt-1 font-bold text-lg">General Application</h4>
              <p class="mt-2 text-sm opacity-80">
                Covers your background, resume, and an ML assessment (or
                equivalent for non-ML roles).
              </p>
            </div>
            <div class="bg-white/5 p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-[#A45DF5]">
                Phase 2
              </span>
              <h4 class="mt-1 font-bold text-lg">Project Selection</h4>
              <p class="mt-2 text-sm opacity-80">
                Indicate your interest in specific projects. Released after
                all new projects for the semester have been announced.
              </p>
            </div>
          </div>
          <p class="mt-6 text-xs opacity-60">
            Both phases must be completed to be considered for a project.
          </p>
        </div>

        <!-- Lead a project / not ready yet: split -->
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="border border-white/15 p-8">
            <h3 class="font-bold text-[#A45DF5] text-lg">Lead a Project</h3>
            <p class="mt-3 text-sm opacity-80">
              Have an innovative idea? PM applications open before project
              recruitment. You'll work with our Project Advisor to scope,
              recruit, and execute. We expect excellence from project
              managers in both leadership and technical skills.
            </p>
          </div>

          <div class="border border-white/15 p-8">
            <h3 class="font-bold text-[#A45DF5] text-lg">Not Ready Yet?</h3>
            <p class="mt-3 text-sm opacity-80">
              Join the{" "}
              <a href="/accelerator" class="font-semibold underline decoration-2 underline-offset-4 hover:opacity-70">
                Accelerator Program
              </a>{" "}
              and build the skills you need to succeed in our projects. We
              also recommend{" "}
              <a href={D2L_URL} class="font-semibold underline decoration-2 underline-offset-4 hover:opacity-70">
                Dive into Deep Learning
              </a>{" "}
              to build a solid foundation in machine learning.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>