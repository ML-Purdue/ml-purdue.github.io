---
import "@fontsource/inter/variable.css";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import ArchiveSearch from "~/components/ArchiveSearch.astro";
import "~/styles/index.css";
import { RGItems, canonicalizeTags } from "~/data-entries";

const { site } = Astro;
const description = "ML@Purdue Website";

const INTEREST_FORM = "https://forms.gle/C3413FpYYJkwHaU27";
const DISCORD_URL = "https://discord.gg/KphYQFSVsu";

// Normalize + expand each item's tags, then build the chip list.
const entries = RGItems.map((item) => ({
  ...item,
  tags: canonicalizeTags(item.domain, item.topic),
}));
const rgTags = [...new Set(entries.flatMap((e) => e.tags))].sort();
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ML@Purdue - Reading Group</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="ML@Purdue" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/social.png" />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header fixed />

    <!-- Hero -->
    <section class="w-full bg-black pt-28 pb-20 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="orbitron font-bold text-6xl sm:text-8xl">Reading Group</h2>
        <p class="mt-6 max-w-3xl text-base opacity-90 sm:text-lg">
          At the heart of research lies a
          <a
            href="https://arxiv.org/stats/monthly_submissions"
            class="font-semibold underline decoration-2 underline-offset-4 hover:opacity-70 hover:!text-white"
            >mountain of papers</a
          >. Every week, a person or group presents a research paper or book chapter they
          find interesting. Participate and you'll have studied ~15 new papers by the end of
          the semester! Join our Discord for details.
        </p>

        <a
          href={DISCORD_URL}
          class="group mt-10 inline-flex items-center gap-3 bg-[#A45DF5] px-8 py-4 text-lg font-semibold text-white transition hover:opacity-90 hover:!text-white"
        >
          Join our Discord
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </section>

    <!-- Interested in presenting? -->
    <section class="w-full bg-[#A45DF5] py-14 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Interested in Presenting?</h2>
        <p class="mt-8 max-w-3xl text-base opacity-90 sm:text-lg">
          Anyone can present! You don't need to be an expert, just curious. Pick a paper or
          book chapter you find interesting and you'll get real practice breaking down research
          and teaching it to the group. Not sure where to start? We recommend
          <a
            href="https://huggingface.co/papers/trending"
            class="font-semibold underline decoration-2 underline-offset-4 hover:opacity-70 hover:!text-white"
            >HuggingFace's trending papers</a
          >
          to find something worth presenting.
        </p>

        <a
          href={INTEREST_FORM}
          class="group mt-10 inline-flex items-center gap-3 bg-white px-8 py-4 text-lg font-semibold text-[#A45DF5] transition hover:opacity-90 hover:!text-[#A45DF5]"
        >
          Sign up to present
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </section>

    <!-- Searchable archive -->
    <section class="w-full bg-white py-20 text-black">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Archive</h2>
        <p class="mt-6 mb-10 max-w-2xl text-lg opacity-70">
          Every past reading group. Search by title or filter by topic.
        </p>

        <ArchiveSearch tags={rgTags}>
          <div class="grid gap-4 sm:grid-cols-2">
            {
              entries.map((e) => (
                <article
                  data-archive-item
                  data-title={e.topic.toLowerCase()}
                  data-tags={e.tags.map((t) => t.toLowerCase()).join("|")}
                  class="flex flex-col border border-black/15 p-6"
                >
                  <h3 class="font-bold text-2xl">{e.topic}</h3>
                  {e.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-2">
                      {e.tags.map((t) => (
                        <span class="bg-[#A45DF5] px-3 py-1 text-xs font-semibold text-white">
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                  <p class="mt-4 text-sm opacity-70">
                    {e.date}
                    {e.room && <span> · {e.room}</span>} · {e.leading}
                  </p>
                  {(e.video || e.slides) && (
                    <div class="mt-4 flex flex-wrap gap-3">
                      {e.video && (
                        <a
                          href={e.video}
                          class="group inline-flex items-center gap-2 border-2 border-current px-3 py-1.5 text-sm font-semibold transition hover:border-[#A45DF5] hover:!text-[#A45DF5]"
                        >
                          Video
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      )}
                      {e.slides && (
                        <a
                          href={e.slides}
                          class="group inline-flex items-center gap-2 border-2 border-current px-3 py-1.5 text-sm font-semibold transition hover:border-[#A45DF5] hover:!text-[#A45DF5]"
                        >
                          Slides
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      )}
                    </div>
                  )}
                </article>
              ))
            }
          </div>
        </ArchiveSearch>
      </div>
    </section>

    <Footer />
  </body>
</html>
