---
import "@fontsource/inter/variable.css";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import "~/styles/index.css";

const { site } = Astro;
const description = "ML@Purdue Website";

// Company logo wall via the Brandfetch Logo API (light wordmarks for the black bg).
// Set your Brandfetch Logo API client ID here; until then the text names show.
const BRANDFETCH_CLIENT_ID = "1idhhwt56ctcfP7O404";
const companies = [
  { name: "Google", domain: "google.com" },
  { name: "Amazon", domain: "amazon.com" },
  { name: "Tesla", domain: "tesla.com" },
  { name: "Apple", domain: "apple.com" },
  { name: "SpaceX", domain: "spacex.com" },
  { name: "NVIDIA", domain: "nvidia.com" },
  { name: "Datadog", domain: "datadoghq.com" },
  { name: "Notion", domain: "notion.so" },
];
const logoUrl = (domain: string) =>
  `https://cdn.brandfetch.io/${domain}/theme/light/logo?c=${BRANDFETCH_CLIENT_ID}`;

type Member = { name: string; role: string; url?: string };

const execBoard: Array<Member> = [
  { name: "Bisti Potdar", role: "President", url: "https://www.linkedin.com/in/bisti-potdar-0a0aa8244/" },
  { name: "Saloni Dhawale", role: "Vice President", url: "https://www.linkedin.com/in/saloni-dhawale-0313b4316/" },
  { name: "Alexandre Sauquet", role: "Director of Projects", url: "https://www.linkedin.com/in/alexandre-sauquet/" },
  { name: "Keshav Sreekantham", role: "Director of Accelerator", url: "https://www.linkedin.com/in/ksreekan/" },
  { name: "Shriya Nichenametla", role: "Director of Marketing", url: "https://www.linkedin.com/in/nshriya/" },
  { name: "Elijah Douglass", role: "Director of Finance", url: "mailto:dougl111@purdue.edu" },
  { name: "Ryan Zhang", role: "Director of Operations", url: "https://www.linkedin.com/in/ryan-zhang-b57424172/" },
];

const officers: Array<Member> = [
  { name: "Christine Xu", role: "Workshop Officer", url: "https://www.linkedin.com/in/christinexu1211/" },
  { name: "Manav Gagvani", role: "Finance Officer", url: "https://www.linkedin.com/in/manav-gagvani/" },
];

const initials = (name: string) =>
  name
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ML@Purdue - About</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="ML@Purdue" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/social.png" />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header fixed />

    <!-- Hero: centered About + intro + logo wall -->
    <section class="w-full bg-black pt-28 pb-16 text-white">
      <div class="mx-auto w-[90vw] max-w-5xl text-center">
        <h2 class="orbitron font-bold text-6xl sm:text-8xl">About</h2>
        <p class="mx-auto mt-8 max-w-4xl text-base opacity-90 sm:text-lg">
          ML@Purdue is Purdue University's premier student organization for machine learning and
          artificial intelligence. More than events and projects, ML@Purdue is a community. We
          connect you with mentors, collaborators, and opportunities that extend well beyond
          campus. Whether you're writing your first line of PyTorch or training models on
          Purdue's HPC clusters, there's a place for you here.
        </p>
      </div>

      <div class="mx-auto mt-20 w-[90vw] max-w-6xl">
        <p class="text-center text-xs uppercase tracking-[0.2em] opacity-50">
          Our members &amp; alumni work at
        </p>
        <div class="mt-12 grid grid-cols-2 items-center justify-items-center gap-x-10 gap-y-10 sm:grid-cols-4">
          {
            companies.map((c) =>
              BRANDFETCH_CLIENT_ID ? (
                <img
                  src={logoUrl(c.domain)}
                  alt={c.name}
                  loading="lazy"
                  class="max-h-10 w-auto max-w-[70%] object-contain sm:max-h-12"
                />
              ) : (
                <span class="text-2xl font-bold text-white/80 sm:text-3xl">{c.name}</span>
              )
            )
          }
        </div>
      </div>
    </section>

    <!-- Executive Board + Officers -->
    <section class="w-full bg-white py-20 text-black">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Executive Board</h2>
        <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3">
          {
            execBoard.map((m) => (
              <a href={m.url} target="_blank" rel="noopener" class="group block">
                <div class="flex aspect-square items-center justify-center bg-black text-white transition-transform duration-200 group-hover:scale-[1.03]">
                  <span class="text-4xl font-bold sm:text-5xl">{initials(m.name)}</span>
                </div>
                <h3 class="mt-4 font-bold text-lg">{m.name}</h3>
                <p class="text-sm opacity-70">{m.role}</p>
              </a>
            ))
          }
        </div>

        <h2 class="mt-20 font-bold text-4xl sm:text-6xl">Officers</h2>
        <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3">
          {
            officers.map((m) => (
              <a href={m.url} target="_blank" rel="noopener" class="group block">
                <div class="flex aspect-square items-center justify-center bg-black text-white transition-transform duration-200 group-hover:scale-[1.03]">
                  <span class="text-4xl font-bold sm:text-5xl">{initials(m.name)}</span>
                </div>
                <h3 class="mt-4 font-bold text-lg">{m.name}</h3>
                <p class="text-sm opacity-70">{m.role}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
